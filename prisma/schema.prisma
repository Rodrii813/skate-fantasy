// Skate Fantasy — modelo de datos
//
// Idea general: un Evento (p.ej. "Libre Senior Femenino" en el
// "Campeonato del Mundo 2026") tiene varios "Slots" de fantasy
// (p.ej. "Mejor combinación de saltos", "Giro combinado", "Componentes").
// El usuario elige un patinador inscrito en ese evento para cada slot.
// El admin, tras la competición, introduce a mano la puntuación real que
// sacó cada patinador en cada categoría de elemento (tal como viene en el
// protocolo oficial). La puntuación fantasy de un usuario = suma de la
// puntuación real obtenida por el patinador que eligió, en el elemento
// que corresponde a cada slot.
//
// Todo el catálogo (disciplinas, categorías de edad, categorías de
// elemento) es editable desde el panel de admin, sin tocar código, porque
// el reglamento de World Skate cambia de temporada en temporada.

// Skate Fantasy — modelo de datos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL debe ser la conexión CON POOLER de Neon (host con
  // "-pooler", vía PgBouncer) — la que usa la app en cada petición, incluidas
  // las funciones serverless de Vercel, que pueden abrir muchas conexiones a
  // la vez. `prisma migrate`/`db push` no funcionan bien contra el pooler
  // (PgBouncer en modo transacción no soporta los prepared statements que
  // usan), así que necesitan la conexión DIRECTA aparte — de ahí DIRECT_URL.
  // Ver .env.example para el porqué de cada una.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum EventStatus {
  UPCOMING   // aún se pueden hacer/editar picks y porras
  LOCKED     // plazo cerrado, competición en curso
  RESULTS_IN // admin cargando puntuaciones
  FINISHED   // evento cerrado, ranking definitivo
}

// Formato de un evento de disciplina "Show" (Cuartetos, Grupos Pequeños,
// Grupos Grandes). Son competiciones separadas (inscritos y horario propio
// cada una, cada una su propio Event), pero como las 3 comparten disciplina
// "Show" no hay forma de saber qué plantilla de slots de Fantasy aplicar sin
// que el evento "recuerde" su formato — ver generate-slots/route.ts. Null
// para cualquier evento que no sea de la disciplina Show.
enum ShowFormat {
  QUARTET
  SMALL_GROUP
  LARGE_GROUP
}

model User {
  id                String                     @id @default(cuid())
  // Nickname público del usuario: se muestra en todos los rankings (Fantasy,
  // Predicciones, Ligas). Es único a propósito — así en el ranking no hay
  // ambigüedad sobre quién es quién.
  name              String                     @unique
  email             String                     @unique
  passwordHash      String
  role              Role                       @default(USER)
  // null = todavía no ha confirmado su email (no puede iniciar sesión, ver
  // src/lib/auth.ts); se rellena con la fecha real de verificación al pulsar
  // el enlace del correo (ver EmailVerificationToken más abajo).
  emailVerified     DateTime?
  createdAt         DateTime                   @default(now())
  rosters           FantasyRoster[]
  predictions       Prediction[]
  ownedLeagues      League[]                   @relation("LeagueOwner")
  leagueMemberships LeagueMembership[]
  passwordResets    PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  pushSubscriptions PushSubscription[]
}

// Avisos automáticos ya enviados (clave única por aviso: "open:<segmentId>"...).
model NotificationLog {
  key       String   @id
  createdAt DateTime @default(now())
}

// Suscripción push de un dispositivo (PWA). Se borra sola si el navegador
// la da de baja (404/410 al enviar).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Recuperación de contraseña: token de un solo uso, con caducidad de 1 hora,
// enviado por email (ver src/lib/email.ts, usa Resend).
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Verificación de email en el registro: token de un solo uso, con caducidad
// de 24 horas, enviado por email (ver src/lib/email.ts, usa Resend). El
// login está bloqueado (ver src/lib/auth.ts) hasta que el usuario confirma
// con el enlace de este token y User.emailVerified deja de ser null.
// Estructura idéntica a PasswordResetToken a propósito, pero como modelo
// aparte: son dos flujos independientes (uno no debe poder usarse para el
// otro) y la caducidad es distinta (24h aquí, 1h en el reset de contraseña).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Discipline {
  id      String   @id @default(cuid())
  name    String   @unique // Libre, Parejas, Solo Danza, Pareja Danza, Inline, Show...
  slug    String   @unique
  events  Event[]
  skaters Skater[]
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique // Senior, Junior, Cadete, Juvenil...
  slug    String   @unique
  order   Int      @default(0)
  events  Event[]
  skaters Skater[]
}

model Competition {
  id        String   @id @default(cuid())
  name      String   // p.ej. "Campeonato del Mundo World Skate Games 2026"
  season    String   @default("2026")
  location  String?  // p.ej. "Rímini, Italia"
  website   String?  // web oficial o enlace a streaming
  startDate DateTime
  endDate   DateTime
  events    Event[]
}

// Un Event = una categoría+disciplina concreta (p.ej. "Solo Danza Senior Femenino")
model Event {
  id            String          @id @default(cuid())
  competitionId String
  competition   Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  disciplineId  String
  discipline    Discipline      @relation(fields: [disciplineId], references: [id])
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  name          String          // "Solo Danza Senior Femenino"
  gender        Gender?         // Género estructurado del evento (opcional; el nombre libre sigue siendo la fuente visible hasta que se rellene)
  rosterLocksAt DateTime        // deadline para fantasy y predicciones
  // Apertura de PREDICCIONES (antes siempre estaban abiertas desde que se
  // creaba el evento, aunque no hubiera patinadores inscritos ni draft):
  // hora a partir de la cual se pueden enviar, y override manual para
  // abrirlas ya mismo — mismo esquema que Segment.opensAt/manuallyOpened del
  // draft. Null = sin hora propia (se abren en cuanto hay patinadores
  // inscritos, comportamiento de siempre en eventos ya existentes).
  predictionsOpensAt        DateTime?
  predictionsManuallyOpened Boolean @default(false)
  scheduledAt   DateTime?       // Fecha y hora real en que la prueba se disputa en pista (calendario público); no confundir con rosterLocksAt
  status        EventStatus     @default(UPCOMING)
  // Solo relevante si discipline.slug === "show": qué formato es este
  // evento en concreto (Cuartetos/Grupos Pequeños/Grupos Grandes), para que
  // generate-slots sepa qué plantilla aplicar sin preguntar cada vez. Null
  // en el resto de disciplinas.
  showFormat    ShowFormat?
  // Evento de práctica (p.ej. antes de tener órdenes de salida reales, para
  // que la gente pruebe Fantasy/Predicciones): se marca a mano desde el
  // admin y se muestra con un aviso en todas las pantallas públicas donde se
  // pueda interactuar con él, para no confundirlo con una prueba real.
  isTest        Boolean         @default(false)
  segments      Segment[]
  slots         FantasySlot[]
  registrations Registration[]
  rosters       FantasyRoster[]
  predictions   Prediction[]
  leagues       LeagueEvent[]

  @@index([competitionId])
}

model Segment {
  id            String         @id @default(cuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String         // Style Dance, Free Dance, Short Program, Long Program...
  order         Int            @default(0)
  // Plazo de fichaje propio de este segmento (Corto y Largo pueden cerrar en
  // momentos distintos). Si es null, este segmento hereda el rosterLocksAt
  // del Event — así los eventos ya existentes (creados antes de este campo)
  // siguen funcionando exactamente igual que antes, sin migración de datos.
  locksAt       DateTime?
  // Hora de APERTURA propia de este segmento: antes de esta hora el estado
  // es "Upcoming" aunque ya existan los slots (p.ej. el Largo no debería
  // abrirse hasta que se sepa el resultado del Corto, aunque su draft ya
  // esté generado con antelación). Si es null, el segmento se considera
  // abierto en cuanto tiene slots generados (comportamiento de siempre).
  opensAt       DateTime?
  // Permite al admin abrir el segmento manualmente aunque `opensAt` todavía
  // no haya llegado (p.ej. el Corto terminó antes de lo previsto). No
  // afecta al cierre (`locksAt`), solo salta el requisito de `opensAt`.
  manuallyOpened Boolean       @default(false)
  // Hora de pista de ESTE segmento en concreto, para el calendario público.
  // Si es null, el calendario sigue usando el scheduledAt del Event entero
  // (comportamiento de siempre, sin romper nada ya creado). Se rellena solo
  // cuando Corto y Largo (u otros segmentos) van a horas distintas.
  scheduledAt      DateTime?
  // Etiqueta opcional para ESTE bloque (el de `scheduledAt`) cuando el
  // segmento está partido en dos sesiones — p.ej. "Less Top 10" mientras
  // splitLabel es "Top 10". Se muestra pegada al nombre del segmento en el
  // calendario ("Long Program Less Top 10"), sin paréntesis. Vacía si el
  // segmento no está partido.
  scheduleLabel    String?
  // Split de horario dentro de este MISMO segmento: mismos inscritos, mismos
  // picks de Fantasy y un único resultado, pero la sesión de pista se reparte
  // en dos bloques a horas distintas (p.ej. Largo: "Top 10" más tarde y
  // "Less Top 10"/"Resto" antes). Si splitLabel+splitScheduledAt están
  // rellenos, el calendario muestra una fila EXTRA para este segmento con
  // esa etiqueta y esa hora, además de la fila normal de arriba. Ambos
  // vacíos = sin split, que es el caso de la inmensa mayoría de segmentos.
  splitLabel       String?
  splitScheduledAt DateTime?
  slots         FantasySlot[]
  elementScores ElementScore[]
  details       SegmentDetail[]

  @@index([eventId])
}

model ElementCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  slots         FantasySlot[]
  elementScores ElementScore[]
}

model FantasySlot {
  id                String          @id @default(cuid())
  eventId           String
  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  elementCategoryId String
  elementCategory   ElementCategory @relation(fields: [elementCategoryId], references: [id])
  segmentId         String?
  segment           Segment?        @relation(fields: [segmentId], references: [id])
  label             String
  order             Int             @default(0)
  picks             FantasyPick[]

  @@index([eventId])
}

model Skater {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  country       String         // Código ISO ("ESP", "ITA", "POR")
  gender        Gender?        // Género real del patinador (opcional; fuente de verdad para género)
  disciplineId  String
  discipline    Discipline     @relation(fields: [disciplineId], references: [id])
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  registrations Registration[]
  picks         FantasyPick[]

  @@index([disciplineId, categoryId])
}

// Inscripción del patinador en un evento concreto con su clasificación general
model Registration {
  id            String         @id @default(cuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  skaterId      String
  skater        Skater         @relation(fields: [skaterId], references: [id])
  
  // Añade estas 3 líneas aquí:
  startOrder    Int?           // Orden de salida (1, 2, 3...) — del Corto (o el único programa)
  startOrderLong Int?          // Orden de salida del Largo; si es null el Largo usa startOrder (datos anteriores)
  warmupGroup   Int?           // Grupo de calentamiento (1, 2, 3...) — legado, no segment-aware; se conserva por compatibilidad con datos antiguos pero no se usa para nada nuevo
  warmupGroupShort Int?        // Grupo de calentamiento del Programa Corto (sorteo propio, distinto del Largo)
  warmupGroupLong  Int?        // Grupo de calentamiento del Programa Largo (se redibuja según el resultado del Corto)
  club          String?        // Club o federación

  // Totales oficiales para el Hub de Competiciones
  segment1Score Float?         // Nota del primer segmento (Short / Style Dance)
  segment2Score Float?         // Nota del segundo segmento (Free / Free Dance)
  totalScore    Float?         // Suma total oficial
  finalRank     Int?           // Puesto final (1º, 2º, 3º...)
  withdrawn     Boolean        @default(false) // No salió a pista (ausente): no cuenta para dar el evento por completo

  // TES/PCS/Deducciones OFICIALES de cada segmento, tal cual los calcula el
  // panel de jueces (no reconstruidos a partir de los slots de Fantasy, que
  // por diseño solo cuentan "los mejores N" de cada tipo de elemento y por
  // eso casi nunca cuadran con el total real). Se guardan aparte para que
  // /resultados y /competitions/[id] puedan mostrar el desglose oficial
  // exacto del acta, igual que aparece en el PDF.
  segment1Tes   Float?
  segment1Pcs   Float?
  segment1Ded   Float?
  segment2Tes   Float?
  segment2Pcs   Float?
  segment2Ded   Float?

  elementScores ElementScore[]
  details       SegmentDetail[]

  @@unique([eventId, skaterId])
}

// Desglose completo del acta (elementos, QOE, notas por juez, components) de
// un patinador en un segmento. Solo se MUESTRA en resultados; no interviene
// en ningún cálculo de puntuaciones ni de Fantasy.
model SegmentDetail {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  segmentId      String
  segment        Segment      @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  data           Json
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([registrationId, segmentId])
}

model ElementScore {
  id                String          @id @default(cuid())
  registrationId    String
  registration      Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  segmentId         String
  segment           Segment         @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  elementCategoryId String
  elementCategory   ElementCategory @relation(fields: [elementCategoryId], references: [id])
  value             Float           // Puntuación obtenida
  note              String?         // Nombre del elemento ("Traveling Lv 4", "3Lo")

  @@unique([registrationId, segmentId, elementCategoryId])
}

model FantasyRoster {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  picks     FantasyPick[]

  @@unique([userId, eventId])
  @@index([eventId])
}

model FantasyPick {
  id       String        @id @default(cuid())
  rosterId String
  roster   FantasyRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  slotId   String
  slot     FantasySlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  skaterId String
  skater   Skater        @relation(fields: [skaterId], references: [id])

  @@unique([rosterId, slotId])
}

// Porras (Prediction Central): Top 3 obligatorio + puestos 4 y 5 opcionales
model Prediction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  rank1SkaterId String   // Patinador para el 1º puesto
  rank2SkaterId String   // Patinador para el 2º puesto
  rank3SkaterId String   // Patinador para el 3º puesto
  rank4SkaterId String?  // Patinador para el 4º puesto (Top 5)
  rank5SkaterId String?  // Patinador para el 5º puesto (Top 5)

  pointsEarned  Float?   // Puntos obtenidos calculados tras publicar resultados
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([eventId])
}

// Ligas privadas: un grupo de amigos que compite en el ranking Fantasy
// limitado a una selección de eventos elegida por quien crea la liga. El
// creador es automáticamente el primer miembro (LeagueMembership), y
// cualquiera puede unirse con el código de invitación mientras lo tenga.
model League {
  id          String             @id @default(cuid())
  name        String
  code        String             @unique // código de invitación, p.ej. "K7QX9P"
  ownerId     String
  owner       User               @relation("LeagueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  events      LeagueEvent[]
  memberships LeagueMembership[]
}

// Eventos que cuentan para el ranking de esta liga (subconjunto de los
// eventos del calendario, elegido por el creador al crear la liga).
model LeagueEvent {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([leagueId, eventId])
  @@index([eventId])
}

model LeagueMembership {
  id       String   @id @default(cuid())
  leagueId String
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  // Administrador de la liga (además de quien la creó, ver League.ownerId):
  // puede echar miembros normales igual que el creador, pero no borrar la
  // liga ni nombrar/quitar a otros administradores — eso sigue siendo cosa
  // solo del creador. Pensado para que la liga siga gestionada aunque quien
  // la creó esté desconectado una temporada. El creador siempre tiene esto a
  // `true` en su propia membership (se pone al crear la liga).
  isAdmin  Boolean  @default(false)

  @@unique([leagueId, userId])
  @@index([userId])
}

// Fila única (singleton, id fijo "singleton") con ajustes globales del sitio
// editables desde el panel de admin sin tocar código. De momento la cuenta
// atrás de la home (antes se detectaba sola buscando una Competition llamada
// "World Skate Games" y se mostraba siempre que existiera una — no había
// forma de quitarla, ni de usarla para otra cosa que no fuera literalmente
// esa competición; ahora el admin decide el texto, la fecha y si se muestra
// o no) y el anuncio de la home (un aviso de texto libre, activable/
// desactivable, para cosas puntuales — p.ej. "todavía no hay órdenes de
// salida" — sin tener que tocar código ni esperar un despliegue para
// quitarlo cuando deje de aplicar).
model SiteSettings {
  id                  String    @id @default("singleton")
  countdownEnabled    Boolean   @default(false)
  countdownTitle      String?
  countdownLocation   String?
  countdownTargetDate DateTime?
  announcementEnabled Boolean   @default(false)
  announcementText    String?
  updatedAt           DateTime  @updatedAt
}