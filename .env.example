# Cadena de conexión de tu base de datos Postgres (Neon, Supabase, Railway, local...)
#
# En Neon hay DOS variantes de la misma base de datos, y hacen falta las dos:
#
# - DATABASE_URL: la conexión CON POOLER (el host lleva "-pooler", p.ej.
#   ep-cool-project-pooler.eu-central-1.aws.neon.tech). Es la que usa la app
#   en cada petición normal (fichar equipo, ver el calendario...). Hace
#   falta porque en Vercel cada función serverless puede abrir su propia
#   conexión a la vez — con muchas visitas simultáneas (p.ej. justo tras
#   publicar unas notas) sin pooler se agotaría el límite de conexiones de
#   Postgres; el pooler de Neon (PgBouncer) aguanta miles a la vez sin coste
#   extra. Añádele "&pgbouncer=true" al final para que Prisma sepa que va
#   contra un pooler en modo transacción.
# - DIRECT_URL: la conexión DIRECTA (sin "-pooler"), solo para
#   `prisma migrate`/`prisma db push` — el pooler en modo transacción no
#   soporta las prepared statements que usan esos comandos.
#
# Copia ambas desde el dashboard de Neon → tu proyecto → "Connection
# Details" (tiene un desplegable "Pooled connection" / "Direct connection").
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/skatefantasy?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/skatefantasy?sslmode=require"

# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-valor-aleatorio"

# URL pública de tu despliegue (en local: http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# Contraseña del admin que crea el seed (cámbiala)
SEED_ADMIN_PASSWORD="changeme123"

# API key de Resend (resend.com), para enviar el email de "recuperar
# contraseña". Sin esta variable, el enlace de recuperación solo se imprime
# en los logs del servidor (útil en local) pero no se envía ningún email de
# verdad.
RESEND_API_KEY=""

# Remitente de esos emails. "onboarding@resend.dev" es el dominio de
# pruebas de Resend y funciona sin verificar un dominio propio — cámbialo
# por el tuyo (p.ej. "Rollart Fantasy <no-reply@tudominio.com>") cuando
# tengas un dominio verificado en Resend.
RESEND_FROM_EMAIL="Rollart Fantasy <onboarding@resend.dev>"

# Brevo (opcional, recomendado): 300 emails/día gratis. Si se configura, se usa
# primero y Resend queda de respaldo. El remitente debe estar verificado en Brevo.
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="Rollart Fantasy"

# Notificaciones push (PWA). Genera las claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
